{
  "name": "skillproof",
  "version": "1.0.0",
  "description": "SkillProof verification platform with React frontend and Node.js backend",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "ts-node-dev --respawn --transpile-only --project tsconfig.backend.json src/server.ts",
    "dev:frontend": "vite",
    "build": "tsc -b && vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "lint": "oxlint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "jest --coverage"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/client": "^5.22.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exif-reader": "^2.0.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.3",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.41.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^7.10.0",
    "qrcode": "^1.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "jest": "^29.7.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
